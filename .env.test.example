# E2E/BSG用のテスト専用Supabase接続設定のテンプレート。
# このファイルを .env.test にコピーして値を埋める（.env.test はgit管理外）。
#
# 重要:
# - 本番Supabaseの値を入れないこと。e2e/env-guard.ts が許可ホスト以外を即失敗させる
# - ローカルSupabase（supabase start）なら E2E_ALLOWED_SUPABASE_HOSTS は不要
# - リモートのテスト専用プロジェクトを使う場合のみ E2E_ALLOWED_SUPABASE_HOSTS にホスト名を明示する

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<テスト環境のanon key>
SUPABASE_SERVICE_ROLE_KEY=<テスト環境のservice role key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
E2E_TEST_EMAIL=e2e-test-user@example.com

# リモートのテスト専用プロジェクトを使う場合のみ（カンマ区切り）
# E2E_ALLOWED_SUPABASE_HOSTS=xxxx.supabase.co
