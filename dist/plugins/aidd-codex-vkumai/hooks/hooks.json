{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/check-direct-ddl-execution.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/codex-dependency-change-deny.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/codex-ai-check-track.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/codex-ai-check-suggest.sh",
            "timeout": 15,
            "statusMessage": "品質チェックの実行有無を確認中..."
          }
        ]
      }
    ]
  }
}
