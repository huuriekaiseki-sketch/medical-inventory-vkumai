{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-direct-ddl-execution.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/codex-skip-marker-deny.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-branch-pr-status.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-branch-tool-ownership.sh codex",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-local-main-freshness.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
