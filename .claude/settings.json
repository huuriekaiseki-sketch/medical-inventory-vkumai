  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-branch-pr-status.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-branch-tool-ownership.sh claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-local-main-freshness.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-otel-collector-status.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-automode-config.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-blocked-issues-staleness.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-fault-injection-drill-staleness.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-workflow-interruption.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-recovery-queue.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-claude-md-size.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-stale-worktrees.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-empty-session-report.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/check-skip-marker-write.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/check-dependency-change.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/check-run-manifest-presence.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash|mcp__.*execute_sql",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/check-direct-ddl-execution.sh", "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/log-subagent-hook-skeleton.sh", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/log-subagent-hook-skeleton.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-domain-decisions-suggest.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/ai-check-suggest.sh",
            "timeout": 15,
            "statusMessage": "ai:check実行有無を確認中..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/verify-claims.sh",
            "timeout": 90,
            "statusMessage": "直前ターンの主張を裏取り中..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/gate-effectiveness-monthly-check.sh",
            "timeout": 15,
            "statusMessage": "品質ゲート月次サマリを確認中..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-gap-check-state.sh",
            "timeout": 90,
            "statusMessage": "AIDD gap check stateを確認中(issue #488)..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-aidd-stats-recorded.sh",
            "timeout": 15,
            "statusMessage": "AIDD stats記録の有無を確認中(issue #495)..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-aidd-phase-stats-recorded.sh",
            "timeout": 15,
            "statusMessage": "AIDD stats phase単位の記録漏れを確認中(issue #524)..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-handoff-format.sh",
            "timeout": 15,
            "statusMessage": "PR引き継ぎフォーマットの有無を確認中(issue #524)..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-find-av-precision-recorded.sh",
            "timeout": 15,
            "statusMessage": "find-av-precisionログ記録の有無を確認中(issue #522)..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
